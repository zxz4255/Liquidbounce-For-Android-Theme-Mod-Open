{
  "schemaVersion": 1,
  "id": "lbmenu",
  "version": "${version}",
  "name": "LiquidBounce Menu",
  "description": "Native GPU-rendered recreation of LiquidBounce's title / multiplayer / singleplayer menus. No browser, no CEF.",
  "authors": ["lbmenu"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.example.lbmenu.LbMenuInitializer"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.12"
  }
}